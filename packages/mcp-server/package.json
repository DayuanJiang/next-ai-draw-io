{
    "name": "@next-ai-drawio/mcp-server",
    "version": "0.4.6",
    "description": "draw.io MCP server for Claude Code, Cursor, Codex and VS Code: the AI draws on a live browser canvas you can also edit by hand, with versions and undo",
    "mcpName": "io.github.DayuanJiang/next-ai-drawio",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "next-ai-drawio-mcp": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc && tsc -p shell && node scripts/copy-assets.mjs && node scripts/fetch-drawio.mjs && node scripts/build-shell.mjs",
        "check-drawio": "node scripts/check-drawio-files.mjs",
        "check-package": "node scripts/check-package.mjs",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "mcp",
        "mcp-server",
        "drawio",
        "draw.io",
        "diagrams.net",
        "diagram",
        "architecture-diagram",
        "flowchart",
        "ai",
        "claude",
        "claude-code",
        "cursor",
        "codex",
        "model-context-protocol"
    ],
    "author": "DayuanJiang",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/DayuanJiang/next-ai-draw-io",
        "directory": "packages/mcp-server"
    },
    "homepage": "https://github.com/DayuanJiang/next-ai-draw-io/tree/main/packages/mcp-server#readme",
    "bugs": {
        "url": "https://github.com/DayuanJiang/next-ai-draw-io/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.31.0",
        "linkedom": "^0.18.0",
        "open": "^11.0.0",
        "pako": "^3.0.0",
        "saxes": "^6.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/pako": "^3.0.0",
        "tsx": "^4.19.0",
        "typescript": "^7.0.0",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "dist"
    ]
}
